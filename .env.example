# ──────────────────────────────────────────────────────────
# AdMob – Caca-Palavra
# Copie este arquivo para .env e preencha com os IDs reais.
# ──────────────────────────────────────────────────────────

# Ativa/desativa os anúncios na build de produção.
# Em desenvolvimento (__DEV__) os anúncios de teste aparecem automaticamente.
EXPO_PUBLIC_BIBLU_ADS_ENABLED=false

# AdMob App IDs (obtidos no painel admob.google.com)
# Deixe vazios para usar os test IDs em dev.
EXPO_PUBLIC_BIBLU_ANDROID_APP_ID=
EXPO_PUBLIC_BIBLU_IOS_APP_ID=

# Banner Unit ID exibido na tela de reveal final do versículo
EXPO_PUBLIC_BIBLU_BANNER_UNIT_ID=
